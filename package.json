{
  "name": "n8n-nodes-silverpoint",
  "version": "0.1.1",
  "description": "n8n community node that draws silverpoint charts from workflow items, as SVG or HTML.",
  "keywords": [
    "n8n-community-node-package",
    "n8n",
    "silverpoint",
    "chart",
    "svg"
  ],
  "license": "MIT",
  "homepage": "https://github.com/ecrespo/n8n-nodes-silverpoint",
  "author": {
    "name": "Ernesto Crespo",
    "email": "ecrespo@gmail.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ecrespo/n8n-nodes-silverpoint.git"
  },
  "silverpoint": {
    "line": "0.11",
    "engine": "0.11.1"
  },
  "scripts": {
    "build": "node scripts/bundle-engine.mjs && n8n-node build && node scripts/after-build.mjs",
    "build:watch": "tsc --watch",
    "dev": "n8n-node dev",
    "lint": "n8n-node lint",
    "lint:fix": "n8n-node lint --fix",
    "generate": "node scripts/make-properties.mjs",
    "check": "node scripts/make-properties.mjs --check && node scripts/vendor.mjs --check",
    "conformance": "node scripts/conformance.mjs",
    "scan": "npx -y @n8n/scan-community-package@0.44.0 .",
    "local-run": "node scripts/local-run.mjs",
    "test": "vitest run",
    "release": "n8n-node release",
    "prepublishOnly": "n8n-node prerelease"
  },
  "files": [
    "dist"
  ],
  "n8n": {
    "n8nNodesApiVersion": 1,
    "strict": true,
    "credentials": [],
    "nodes": [
      "dist/nodes/Silverpoint/Silverpoint.node.js"
    ]
  },
  "devDependencies": {
    "@n8n/node-cli": "0.57.4",
    "esbuild": "^0.25.0",
    "eslint": "9.29.0",
    "n8n-workflow": "2.48.3",
    "prettier": "3.6.2",
    "typescript": "5.9.2",
    "vitest": "^3.2.0"
  },
  "peerDependencies": {
    "n8n-workflow": "*"
  }
}
